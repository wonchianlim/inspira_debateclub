# 依赖与构建产物
node_modules/
.next/
out/
build/
dist/

# 环境变量：绝不提交真实密钥
# .env.example 可以提交（只含变量名，不含真实值）
.env
.env.local
.env.*.local

# Supabase 本地开发环境的临时数据
supabase/.temp/
supabase/.branches/

# 测试产物
coverage/
playwright-report/
test-results/
.nyc_output/

# 编辑器与操作系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# 日志
*.log
npm-debug.log*

# npm 缓存（放在项目内，绕开 ~/.npm 的沙箱限制）
.npm-cache/
next-env.d.ts
*.tsbuildinfo
.vercel
/.next
