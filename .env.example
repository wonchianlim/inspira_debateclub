# INSPIRA 环境变量示例
#
# 用法：把本文件复制为 .env.local，再填入真实值。
#   cp .env.example .env.local
#
# 重要：
# - 本文件只列**变量名**，永远不要在这里写真实的密钥。
# - .env.local 已被 .gitignore 忽略，不会被提交。
# - 前缀 NEXT_PUBLIC_ 的变量会被打包进浏览器代码，任何人都能看到。
#   因此**只有**本来就公开的值（例如 Supabase 的匿名 key）才可以用这个前缀。
#   任何密钥、令牌、密码都**不得**使用 NEXT_PUBLIC_ 前缀。

# ---------------------------------------------------------------------------
# 必需：数据库与认证（Supabase）
# 缺失时应用会在启动时直接失败，并列出缺了哪一项（见 instrumentation.ts）。
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# 必需：应用自身的公开地址
# 用于认证重定向与密码重置邮件里的回跳链接。
# 必须包含协议，例如 https://app.example.com；本地开发用 http://localhost:3000
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# 必需：频率限制使用的盐
#
# 登录与找回密码会按来源 IP 限流。为避免在数据库里明文保存 IP，
# 程序会用这个盐做 SHA-256 后再存储（见 supabase/migrations 的
# 20260929091400_rate_limiting.sql）。请填一串随机字符，至少 32 位。
#
# 生成方法（在终端执行）：openssl rand -hex 32
# ---------------------------------------------------------------------------
RATE_LIMIT_SALT=

# ---------------------------------------------------------------------------
# 可选：邮件发送（Phase 9 实现邮件功能时才会变成必需）
# 邮件服务商尚未最终确定（见 docs/decisions/0009 的 A-4 项）。
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# 可选：定时任务接口的共享密钥（实现该接口时才会变成必需）
# 用于保护 POST /api/jobs/dispatch-email，防止外部调用。
# 建议至少 32 个随机字符。
# ---------------------------------------------------------------------------
JOB_DISPATCH_SECRET=
